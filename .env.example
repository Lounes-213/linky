# Cloudflare Workers API
API_BASE_URL=https://linky-api.YOUR_SUBDOMAIN.workers.dev

# Firebase (auto-filled by flutterfire configure)
FIREBASE_PROJECT_ID=your-project-id

# JWT Secret (must match wrangler.toml)
JWT_SECRET=linky-secret-key-change-in-production

# Sofizpay CIB/Edahabiya Payment
SOFIZPAY_ACCOUNT=your-sofizpay-account-key
